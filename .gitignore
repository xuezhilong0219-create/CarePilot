.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
# 原始知识库导出内容未脱敏前不要入库
data/raw/
*.sqlite
*.db
# 真实知识库及其衍生物（清洗结果、索引、评估集、报告）含内部资料，不入库
data/kb_real/
data/index/
eval/real/
.worktrees/
data/models/
jieba.cache
pytest-cache-files-*/
.pytest-probe-*/
# worker 沙箱留下的临时目录
.tmp_test/
# 随手放的临时目录（压测、调试脚本、别处的草稿），不是项目内容
.tmp*/
.pytest_tmp*/
.local_tmp_mode/
.pytest-probe-*/
data/traces/

# SQLite 运行期伴生文件、运行时 trace 与临时现场数据
*.sqlite-wal
*.sqlite-shm
*.sqlite.lock
*.lock
data/live_*
data/*_traces/
